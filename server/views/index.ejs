<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Карта с Яндекс API</title>
    <link rel="stylesheet" href="css/style_map.css">
    <script src="https://api-maps.yandex.ru/2.1/?apikey=b60bc48f-6c15-43ef-a413-83f0e9843255&lang=ru_RU" type="text/javascript"></script>
</head>
<body>
    <%- include("header",{my_tytle:"Расположение рекламных конструкций"}) %>
    <!-- Кнопка для открытия/закрытия фильтров -->
    <button class="open-filters-btn" onclick="toggleFilters()">Фильтры</button>

    <!-- Сайдбар с фильтрами -->
    <div id="filter-sidebar" class="filter-sidebar">
        <div id="filter-form" class="filter-content">
            
            <!-- Фильтр по типу конструкции -->
            <!-- Пример группировки -->
            <br><br></bk><h3>Тип конструкции</h3>

            <!-- Группа 1: Стандартные конструкции -->
            <fieldset class="filter-group">
                <legend>Стандартные</legend>
                <label><input type="checkbox" name="type" value="ОН" checked> ОН</label>
                <label><input type="checkbox" name="type" value="Билборд" checked> Билборд</label>
                <label><input type="checkbox" name="type" value="Экран" checked> Экран</label>
                <label><input type="checkbox" name="type" value="Призма" checked> Призма</label>

            </fieldset>

            <!-- Группа 2: Малые формы -->
            <fieldset class="filter-group">
                <legend>Малые формы</legend>
                <label><input type="checkbox" name="type" value="Стенд" checked> Стенд</label>
                <label><input type="checkbox" name="type" value="Сити-формат" checked> Сити-формат</label>
                <label><input type="checkbox" name="type" value="Флагшток" checked> Флагшток</label>
            </fieldset>

            <!-- Группа 3: Специализированные -->
            <fieldset class="filter-group">
                <legend>Специализированные</legend>
                <label><input type="checkbox" name="type" value="Пиллар" checked> Пиллар</label>
                <label><input type="checkbox" name="type" value="Стела" checked> Стела</label>
                <label><input type="checkbox" name="type" value="Стела АЗС" checked> Стела АЗС</label>
                <label><input type="checkbox" name="type" value="ОП" checked> ОП</label>
            </fieldset>

            <!-- Фильтр по статусу занятости -->
            <h3>Статус занятости</h3>
            <label><input type="checkbox" name="occupancy" value="free" checked> Свободные</label>
            <label><input type="checkbox" name="occupancy" value="occupied" checked> Занятые</label>
            
            <button type="button" onclick="applyFilters()">Применить фильтры</button>
        </div>
    </div>
    <!-- Карта Яндекс -->
    <div id="map" style="width: 100%; height: 100vh;"></div>


    <!-- Подключаем JavaScript файлы -->
    <script src="/js/auth.js"></script>
    <script src="/js/database.js"></script>
    <script src="/js/mapManager.js"></script>
    <script src="/js/uiManager.js"></script>
    <script src="/js/script.js"></script>
    
    <!-- Подключаем футер-->
    <%- include("footer") %>
</body>
</html>